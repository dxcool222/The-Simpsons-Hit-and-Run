# sdl pkg-config source file

prefix=/Users/dxemike/Desktop/untitled folder 15/Projects/SimpsonsTVOS/Build/AppleTV/thirdparty/install/SDL2
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: sdl2
Description: Simple DirectMedia Layer is a cross-platform multimedia library designed to provide low level access to audio, keyboard, mouse, joystick, 3D hardware via OpenGL, and 2D video framebuffer.
Version: 2.32.10
Requires.private: 
Conflicts:
Libs: -L${libdir}   -lSDL2    -lpthread  -lm -Wl,-framework,CoreVideo -Wl,-framework,CoreAudio -Wl,-framework,AudioToolbox -Wl,-framework,AVFoundation -Wl,-framework,CoreBluetooth -Wl,-framework,CoreGraphics -Wl,-framework,Foundation -Wl,-weak_framework,GameController -Wl,-framework,Metal -Wl,-framework,OpenGLES -Wl,-framework,QuartzCore -Wl,-framework,UIKit -Wl,-weak_framework,CoreHaptics
Cflags: -I${includedir} -I${includedir}/SDL2  -D_REENTRANT
